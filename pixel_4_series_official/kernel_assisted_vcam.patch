+EXPORT_SYMBOL(vcam_custom_frame);
+EXPORT_SYMBOL(vcam_frame_size);
+EXPORT_SYMBOL(vcam_frame_ready);
+
+static ssize_t vcam_write(struct file *file, const char __user *ubuf, size_t count, loff_t *ppos)
+{
+	/* If the frame size changes or buffer isn't allocated, allocate it */
+	if (!vcam_custom_frame || vcam_frame_size != count) {
+		if (vcam_custom_frame) 
+			vfree(vcam_custom_frame);
+		/* vmalloc is safe for large video frame byte arrays */
+		vcam_custom_frame = vmalloc(count);
+		vcam_frame_size = count;
+	}
+
+	if (!vcam_custom_frame) {
+		CAM_ERR(CAM_MEM, "Failed to allocate kernel memory");
+		return -ENOMEM;
+	}
+
+	/* Copy the raw video frame bytes from the Android App to Kernel Space */
+	if (copy_from_user(vcam_custom_frame, ubuf, count)) {
+		CAM_ERR(CAM_MEM, "copy_from_user failed");
+		return -EFAULT;
+	}
+
+	vcam_frame_ready = true;
+	return count;
+}
+
+static struct work_struct vcam_work;
+
+static void vcam_work_func(struct work_struct *work)
+{
+	int i;
+	size_t copy_size;
+	if (!vcam_frame_ready || !vcam_custom_frame || vcam_frame_size == 0)
+		return;
+
+	/* We can safely lock the memory table here because we are in a Workqueue thread */
+	mutex_lock(&tbl.m_lock);
+	
+	/* Loop through all active camera buffers */
+	for (i = 1; i < CAM_MEM_BUFQ_MAX; i++) {
+		if (tbl.bufq[i].active && tbl.bufq[i].kmdvaddr) {
+			
+			if (tbl.bufq[i].len > 2000000) {
+				
+				/* Copy whichever is smaller to prevent memory overflow crashes */
+				copy_size = (tbl.bufq[i].len < vcam_frame_size) ? tbl.bufq[i].len : vcam_frame_size;
+				
+				memcpy((void *)tbl.bufq[i].kmdvaddr, vcam_custom_frame, copy_size);
+			}
+		}
+	}
+	mutex_unlock(&tbl.m_lock);
+}
+
+void vcam_trigger_frame_update(void)
+{
+	schedule_work(&vcam_work);
+}
+EXPORT_SYMBOL(vcam_trigger_frame_update);
