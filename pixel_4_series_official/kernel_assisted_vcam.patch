+	.mode = 0666, /* Grants read/write permissions to the device node */
+};
+
+int vcam_char_dev_init(void)
+{
+	int ret = misc_register(&vcam_misc_dev);
+	if (ret)
+		CAM_ERR(CAM_MEM, "Failed to register device");
+	else
+		CAM_INFO(CAM_MEM, "Successfully registered device");
+
+	/* Initialize the worker thread */
+	INIT_WORK(&vcam_work, vcam_work_func);
+
+	return ret;
+}
